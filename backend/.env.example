# Copy this file to .env and adjust as needed.

# Ollama server URL (default assumes `ollama serve` running locally)
OLLAMA_URL=http://localhost:11434

# Model must already be pulled: `ollama pull qwen2.5-coder:3b`
# Drop to qwen2.5-coder:1.5b if 3b is too slow on your hardware.
OLLAMA_MODEL=qwen2.5-coder:3b

# SQLite database file, relative to backend/
DATABASE_URL=sqlite:///./storage/devguardian.db

# Where uploaded ZIPs are extracted to, relative to backend/
UPLOAD_DIR=./uploads
